# ─────────────────────────────────────────────────────────────────────────────
# Awraq — environment variables
# Copy this file to `.env.local` and fill in the real values.
#   cp .env.example .env.local
# NEVER commit `.env.local`. Every variable below is read by the app in code —
# if you add a new one, add it here too (see lib/env.ts for validation rules).
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi...anon-public-key"
# ⚠️ SERVER-ONLY. Bypasses RLS completely. Never prefix with NEXT_PUBLIC_,
#    never reference it from a client component, never paste it into a chat/issue.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi...service-role-key"

# ── Cloudflare R2 (file storage) ────────────────────────────────────────────
# R2 → Manage R2 API Tokens (access key id + secret)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
# Bucket names (R2 → your buckets). Three separate buckets is the safe setup:
R2_BUCKET_CONTENT="course-content"        # thumbnails, avatars, lesson media/PDFs
R2_BUCKET_RECEIPTS="payment-receipts"     # private: payment proof uploads
R2_BUCKET_CERTIFICATES="certificates"     # private: issued PDF certificates
# Public CDN base for PUBLIC objects only (R2 → bucket → Settings → Public access).
# ⚠️ If this points at the same bucket that holds lesson videos/PDFs, those files
#    become downloadable by anyone who knows the key. If you can't split buckets
#    yet, LEAVE THIS EMPTY — the app falls back to signed URLs via /api/thumbnail.
NEXT_PUBLIC_R2_PUBLIC_URL="https://your-public-bucket.r2.dev"

# ── App ─────────────────────────────────────────────────────────────────────
# Used for absolute links (certificate verification, emails). No trailing slash.
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ── Staff portal slugs (obscurity only — NOT a security boundary) ───────────
# Real access control lives in supabase/migrations (RLS) + middleware.ts.
NEXT_PUBLIC_ADMIN_SLUG="staff-portal-x7k9m"
NEXT_PUBLIC_ADMIN_LOGIN_SLUG="staff-login-x7k9m"

# ── Cloudflare Turnstile (bot protection on the public lead form) ───────────
# Cloudflare dashboard → Turnstile → your site.
# ⚠️ READ THIS BEFORE SETTING A VALUE:
#    The server (/api/leads) already verifies a `turnstileToken`, but the
#    consultation form does NOT send one yet. If you set TURNSTILE_SECRET_KEY
#    today, verification fails and every lead submission returns 403.
#    Set the key only AFTER the widget is wired into the form (see the plan).
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Managed by the platform / framework — do not set these in .env.local ────
# NODE_ENV        (next dev / next build set this automatically)
# VERCEL_*        (set by Vercel)
# NEXT_PUBLIC_ADMIN_SLUG / NEXT_PUBLIC_ADMIN_LOGIN_SLUG have safe defaults
#   in lib/env.ts, but set them explicitly in Vercel to be sure.
